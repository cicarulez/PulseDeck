{
  "manifest_version": 3,
  "name": "PulseDeck \u00b7 YouTube",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Invia a PulseDeck il video principale di YouTube, ignorando le anteprime. Integrazione locale opzionale.",
  "key": "",
  "permissions": [
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_title": "PulseDeck \u00b7 YouTube",
    "default_popup": "popup.html"
  }
}
