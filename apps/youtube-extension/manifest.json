{
  "manifest_version": 3,
  "name": "PulseDeck · Chrome",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "description": "Video principale YouTube e icona della scheda Chrome attiva. Integrazione locale opzionale per PulseDeck.",
  "key": "",
  "permissions": [
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_title": "PulseDeck · Chrome",
    "default_popup": "popup.html"
  },
  "optional_permissions": [
    "tabs",
    "favicon"
  ]
}
